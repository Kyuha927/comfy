# Safe, runnable default. It creates deterministic demo artifacts and never loads model weights.
YUE2_MUSIC_OS_ENGINE=mock
YUE2_MUSIC_OS_DATA=./var
YUE2_MUSIC_OS_API_TOKEN=
# Comma-separated Host header allow-list. Add the actual DNS name for remote access.
YUE2_MUSIC_OS_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
YUE2_MUSIC_OS_MAX_UPLOAD_BYTES=524288000
YUE2_MUSIC_OS_COMMAND_TIMEOUT_SECONDS=10800

# Model-use policy. YuE2 and SheetSage2 public weights are noncommercial by default.
# Values: noncommercial | commercial-licensed
YUE2_MUSIC_OS_MODEL_USE_SCOPE=noncommercial
YUE2_MUSIC_OS_COMMERCIAL_LICENSE_REFERENCE=

# Real local Linux/NVIDIA worker configuration.
YUE2_MUSIC_OS_YUE2_PYTHON=./runtime/yue2/.venv/bin/python
YUE2_MUSIC_OS_YUE2_REPO=./runtime/yue2/YuE
YUE2_MUSIC_OS_YUE2_MODEL=m-a-p/YuE2-3B
YUE2_MUSIC_OS_YUE2_REVISION=
YUE2_MUSIC_OS_YUE2_VAE=m-a-p/YuE2-Vae
YUE2_MUSIC_OS_YUE2_VAE_REVISION=

YUE2_MUSIC_OS_SHEETSAGE2_PYTHON=./runtime/sheetsage2/.venv/bin/python
YUE2_MUSIC_OS_SHEETSAGE2_DIR=./runtime/sheetsage2/model
YUE2_MUSIC_OS_SHEETSAGE2_MODEL=m-a-p/SheetSage2
YUE2_MUSIC_OS_SHEETSAGE2_REVISION=
YUE2_MUSIC_OS_SHEETSAGE2_BASE_MODEL=

# Sequential GPU execution is intentional. Increase only after measured VRAM/load tests.
YUE2_MUSIC_OS_GPU_WORKERS=1

# Optional external final-renderer bridges. Built-in Flow/Lyria, Suno, and Eleven entries
# are manual export packages and require no configuration. Command adapters use argv only,
# never a shell. Keep credentials out of this JSON.
# YUE2_MUSIC_OS_RENDER_PROVIDERS_JSON={"lyria-bridge":{"label":"Operator Lyria bridge","mode":"command","argv":["/absolute/path/to/python","/absolute/path/to/adapter.py","{request_json}","{output_dir}"],"timeout_seconds":1800,"commercial_status":"operator-verified","terms_reference":"contract-001"}}


# Optional Note IR command providers. Keep executables absolute and record licenses.
# See docs/NOTE_IR.md and examples/note-provider-config.example.json.
# YUE2_MUSIC_OS_NOTE_PROVIDERS_JSON={}
