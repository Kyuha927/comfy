<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kyuha927.wbcp</string>
  <key>ProgramArguments</key>
  <array>
    <string>__VENV__/bin/wbcp</string>
    <string>serve-http</string>
    <string>--bind</string><string>127.0.0.1</string>
    <string>--port</string><string>8765</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>WBCP_DATA_DIR</key><string>__DATA_DIR__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__LOG_DIR__/wbcp.stdout.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/wbcp.stderr.log</string>
  <key>ThrottleInterval</key><integer>10</integer>
</dict>
</plist>
