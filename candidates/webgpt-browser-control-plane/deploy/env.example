# Copy to a local chmod 600 file outside the repository. Never commit real values.
WBCP_DATA_DIR=/Users/macpro/Library/Application Support/WBCP
WBCP_ALLOWED_HOSTS=example.com,api.example.com
WBCP_HOST_SUBJECT=macpro-wbcp-local
WBCP_PERMIT_SIGNING_KEY=base64:REPLACE_WITH_32_OR_MORE_RANDOM_BYTES
WBCP_APPROVAL_SIGNING_KEY=base64:REPLACE_WITH_DIFFERENT_32_OR_MORE_RANDOM_BYTES
WBCP_EVIDENCE_HMAC_KEY=base64:REPLACE_WITH_DIFFERENT_32_OR_MORE_RANDOM_BYTES
WBCP_HTTP_BEARER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WBCP_HTTP_ALLOWED_HOSTS=127.0.0.1,localhost
WBCP_HTTP_ALLOWED_ORIGINS=https://chatgpt.com
WBCP_HTTP_REQUIRE_ORIGIN=false
WBCP_HTTP_MAX_REQUEST_BYTES=1048576
WBCP_HTTP_MAX_BATCH_ITEMS=32
WBCP_HTTP_PRINCIPAL_ID=chatgpt-mcp-client
# Empty means all reviewed MCP tools; production should list only the required tool names.
WBCP_HTTP_ALLOWED_TOOLS=browser.health,browser.session.create,browser.session.close,browser.inspect,browser.navigate,browser.query,browser.action.preflight,browser.action.authorize,browser.action.commit,browser.job.get,browser.job.cancel,browser.evidence.get
WBCP_HTTP_REQUESTS_PER_MINUTE=120
WBCP_HTTP_MAX_CONCURRENT_REQUESTS=8
WBCP_HEADLESS=true
WBCP_R4_MODE=block
WBCP_MAXIMUM_ACTION_COST=100.0
WBCP_CURRENCY=USD
